
name: Build Android APK

on:
  workflow_dispatch:

  push:
    branches:
      - main
    paths:
      - 'lib/**'
      - 'android/**'
      - 'assets/**'
      - 'pubspec.yaml'
      - 'pubspec.lock'

permissions:
  contents: read

jobs:
  build:
    name: Build Flutter Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Flutter Version
        run: flutter --version

      - name: Get Dependencies
        run: flutter pub get

      - name: Build Release APK
        run: flutter build apk --release

      - name: Verify and Rename APK
        shell: bash
        run: |
          echo "Searching for generated APK..."

          find build -type f -name "*.apk" -print

          APK="build/app/outputs/flutter-apk/app-release.apk"

          if [ ! -f "$APK" ]; then
            echo "ERROR: APK was not found!"
            exit 1
          fi

          cp "$APK" \
            build/app/outputs/flutter-apk/exams_automation-release.apk

          echo "APK generated successfully:"
          ls -lh build/app/outputs/flutter-apk/

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: Exams-automation-Android-APK
          path: build/app/outputs/flutter-apk/exams_automation-release.apk
          retention-days: 30
